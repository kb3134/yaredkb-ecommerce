# ==============================================================================
# RAILWAY DEPLOYMENT ENVIRONMENT VARIABLES (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RAILWAY SYSTEM & SERVER CONFIGURATION (BACKEND ONLY - NEVER EXPOSE TO FRONTEND)
# ------------------------------------------------------------------------------
# Dynamic port assigned automatically by Railway (Defaults to 3000 if not set)
PORT=3000

# Node environment
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. PERMANENT DATABASE CONFIGURATION (RAILWAY POSTGRESQL)
# ------------------------------------------------------------------------------
# Railway automatically populates DATABASE_URL when you attach a PostgreSQL database.
# Format: postgresql://postgres:password@host:port/railway
DATABASE_URL=

# Fallback individual PostgreSQL connection variables (if DATABASE_URL is not used)
# SQL_HOST=
# SQL_PORT=5432
# SQL_USER=postgres
# SQL_PASSWORD=
# SQL_DB_NAME=postgres

# ------------------------------------------------------------------------------
# 3. PERMANENT IMAGE STORAGE (GITHUB REPOSITORY BACKEND)
# ------------------------------------------------------------------------------
# GitHub Personal Access Token (PAT) with repo scope for uploading images to GitHub
GITHUB_TOKEN=
GITHUB_OWNER=kb3134
GITHUB_REPO=yaredkb-ecommerce
GITHUB_BRANCH=main
GITHUB_FOLDER=public/uploads

# ------------------------------------------------------------------------------
# 4. ADMIN AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Password123!
JWT_SECRET=super_secret_jwt_key_change_me_in_production

# ------------------------------------------------------------------------------
# 5. OPTIONAL SERVICES (GEMINI AI & OTHER CLOUD STORAGE)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=

# Optional S3 / Cloudflare R2 / Cloudinary fallbacks
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
